{
  "keybinds": {
    "leader": "ctrl+x",
    "messages.copy": "<leader>y",
    "session.copy": "<leader>c",
    "session.compact": "<leader>z",
    "session.tab.next": "<leader>tab",
    "prompt.editor": "<leader>e",
    "model.dialog.favorite": "<leader>f",
    "model.list": "<leader>m",
    "variant.cycle": "ctrl+t",
    "variant.list": "<leader>v"
  },
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "lucent-orng",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "verbosity": "medium",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal",
    "indicators": "status"
  },
  "scroll": {
    "speed": 4,
    "acceleration": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "terminal": {
    "copy": "select"
  }
}
