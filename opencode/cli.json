{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "system"
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "verbosity": "medium",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "tabs": {
    "mode": "auto"
  },
  "scroll": {
    "speed": 4,
    "acceleration": true
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "terminal": {
    "copy": "select"
  }
}
